rl":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-04.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-04.md","evidence_basis":"structured_case_metadata","relevance_status":"unreviewed","occurrences":[{"id":"bco:35-14--case:cases/ga51_2024__2023-04.md:occ-769698506efe","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-04.html","repository_path":"cases/ga51_2024__2023-04.md","locator":{},"excerpt":"","sources":["cases.jsonl:bco_cited_as","cases.jsonl:bco_cited_current","judicial_cases.jsonl:bco_provisions"],"raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-04.md"}],"reference_presentation":{"group":"review","label":null},"metadata":{"topics":["Sabbath observance","Super Bowl party","review and control","session records review","SJC jurisdiction","exception of substance","Westminster Confession 21:8","WLC 117","WLC 118","BCO 40-2","BCO 40-3","non-justiciability","adjacent courts","RAO Chapter 16"],"standard_of_review":"not_stated","case_numbers":["2023-4"],"body":"SJC","synopsis":"Biese and others complained that Tennessee Valley Presbytery erred by approving Redeemer Church session minutes without exception—minutes noting a youth Super Bowl party—and by denying their complaint seeking a Sabbath exception. The SJC denied the complaint: because Presbytery gave no reasons for its actions, the record was insufficient to find it erred in interpreting the Constitution. A concurrence said the denial did not decide the Sabbath merits; a dissent would have held the complaint judicially out of order for lack of SJC jurisdiction over presbytery record review."}},{"id":"bco:35-14--case:cases/ga51_2024__2023-19.md","record_id":"case:cases/ga51_2024__2023-19.md","type":"Judicial case","title":"Huffman v. Tennessee Valley Presbytery","year":2024,"disposition":"other","authority_weight":"high","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-19.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-19.md","evidence_basis":"structured_case_metadata","relevance_status":"unreviewed","occurrences":[{"id":"bco:35-14--case:cases/ga51_2024__2023-19.md:occ-6894d94572a3","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-19.html","repository_path":"cases/ga51_2024__2023-19.md","locator":{},"excerpt":"","sources":["cases.jsonl:bco_cited_as","cases.jsonl:bco_cited_current","judicial_cases.jsonl:bco_provisions"],"raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-19.md"}],"reference_presentation":{"group":"review","label":null},"metadata":{"topics":["BCO 38-1 case without process","retroactive application of amended BCO","complaint vs. appeal","confession of sin","judicially out of order","remand","50th General Assembly BCO amendment"],"standard_of_review":"not_reached","case_numbers":["2023-19"],"body":"SJC","synopsis":"A filing challenging Presbytery’s handling of Huffman’s BCO 38-1 confession was styled as an appeal under a newly amended rule. The SJC found it judicially out of order because the case began and was nearly completed when the former rule provided review by complaint, and retroactive application would be unfair. It remanded for Presbytery to adjudicate the filing as a complaint at its next stated meeting; denial or failure to act permits review by the SJC. No merits issue was decided."}},{"id":"bco:35-14--case:cases/ga51_2024__2023-06_2023-08.md","record_id":"case:cases/ga51_2024__2023-06_2023-08.md","type":"Judicial case","title":"Knox Baird et al. v. Grace Presbytery","year":2024,"disposition":"partially_sustained","authority_weight":"high","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-06_2023-08.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-06_2023-08.md","evidence_basis":"direct_text","relevance_status":"unrev