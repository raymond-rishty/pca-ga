":[],"raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/inquiries/ga29_2001__ci04.md"}],"reference_presentation":{"group":"review","label":null}},{"id":"bco:6-2--inquiry:inquiries/ga12_1984__ci07.md","record_id":"inquiry:inquiries/ga12_1984__ci07.md","type":"Constitutional inquiry","title":"Whether congregation may set minimum voting age for elections","year":1984,"disposition":"advice given","authority_weight":"medium","url":"https://raymond-rishty.github.io/pca-ga/inquiries/ga12_1984__ci07.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/inquiries/ga12_1984__ci07.md","evidence_basis":"structured_provision_tag","relevance_status":"unreviewed","occurrences":[{"id":"bco:6-2--inquiry:inquiries/ga12_1984__ci07.md:occ-aa77b0b016c9","url":"https://raymond-rishty.github.io/pca-ga/inquiries/ga12_1984__ci07.html","repository_path":"inquiries/ga12_1984__ci07.md","locator":{},"excerpt":"The BCO provides no minimum voting age for congregational meetings, except where state law imposes one for corporate votes.","sources":[],"raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/inquiries/ga12_1984__ci07.md"}],"reference_presentation":{"group":"review","label":null}},{"id":"bco:6-2--case:cases/ga51_2024__2023-11.md","record_id":"case:cases/ga51_2024__2023-11.md","type":"Judicial case","title":"Psiaki v. Pacific Northwest Presbytery","year":2024,"disposition":"sustained","authority_weight":"high","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-11.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-11.md","evidence_basis":"direct_text","relevance_status":"unreviewed","occurrences":[{"id":"bco:6-2--case:cases/ga51_2024__2023-11.md:occ-7c335dbac437","url":"https://raymond-rishty.github.io/pca-ga/cases/ga51_2024__2023-11.html","repository_path":"cases/ga51_2024__2023-11.md","locator":{"fragment":null,"line":173},"excerpt":"> Question: That the Presbytery ask the General Assembly's Permanent Committee on Judicial Business if a congregation may be permitted to set a minimum age for voting in view of BCO 6- 2, 6-4, 24-3, 25-1 and 25-3.","sources":["case_markdown_text","cases.jsonl:bco_cited_as","cases.jsonl:bco_cited_current","judicial_cases.jsonl:bco_provisions"],"raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/cases/ga51_2024__2023-11.md"}],"reference_presentation":{"group":"review","label":null},"metadata":{"topics":["minor communicant voting","congregational meeting","voting rights","good and regular standing","church bylaws","officer election","communicant membership","BCO 6-4","BCO 20-3","BCO 24-3","BCO 25-1","age restrictions","session authority"],"standard_of_review":"not_stated","case_numbers":["2023-11"],"body":"SJC","synopsis":"The SJC sustained Psiaki’s complaint and held that the CPC Session erred by ordaining and installing officers elected at a February 5, 2023 congregational meeting where the congregation’s bylaw excluded communing members under 18 from voting. Reading BCO 6-4, 25-1, and 25-7 together, the SJC ruled that all communing members are entitled to vote and that local bylaws cannot impose an age restriction; the “good and regular standing” language addresses censure, not age. The decision did not annul the completed ordination/installation, but required future elections and installations to comply with the Constitution."}},{"id":"bco:6-2--overture:ga17_1989:19","record_id":"overture:ga17_1989:19","type":"Overture","title":"Limit GA Nominations to Those Nominated by Presbyteries","year":1989,"disposition":"Referred","authority_weight":"low-but-important","url":"https://raymond-rishty.github.io/pca-ga/markdown/ga17_1989.html","raw_url":"https://raw.githubusercontent.com/raymond-rishty/pca-ga/main/markdown/ga17_1989.md","evidence_basis":"title_subject_reference","relevance_status":"unreviewed","occurrences":[{"id":"bco:6-2--overture:ga17_1989:19:occ-9ffc9d238f3c","url"