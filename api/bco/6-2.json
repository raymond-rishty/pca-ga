{"schema_version":3,"catalogue_version":1,"id":"bco:6-2","provision":"BCO 6-2","book":"bco","book_name":"Book of Church Order","abbreviation":"BCO","reference":"6-2","title":"Section 6-2","supplementary":false,"canonical_url":"https://raymond-rishty.github.io/pca-ga/provisions/bco/6-2/","reader_url":"https://raymond-rishty.github.io/pca-constitution-reader/#bco/6-2","current_text":{"html":"<p>Communing members are those who have made a profession of faith in Christ, have been baptized, and have been admitted by the Session to the Lord's Table. (See <i>BCO</i> 46-4 for associate members).</p>","text":"Communing members are those who have made a profession of faith in Christ, have been baptized, and have been admitted by the Session to the Lord's Table. (See BCO 46-4 for associate members)."},"source":{"name":"PCA Constitution Reader","revision":"edce8a8dcd9ced63bb585bf922e6a97319ef62e1","edition":"Current Reader text","files":{"bco.js":"c88e552545b73fd9690de620b237895b7ea52a94bed8e95690c116bf76be8ae5","wcf.js":"1ebf9e54223f7fe4e728a3e640c833a435af825d74b5ef3d4b04687685538a0d","wlc.js":"f6977e761ea4ccc93b07fcacfd0391890cb05b42f4317d807fa293c078d9b051","wsc.js":"dd775417f7ef21e3283bacad5e6ef193c41d64d03bd5a2e8fb934ccca8cb8e53","rao.js":"49808bbb0e95abdc3b07506c87dde0d62d087851e869b49c0f1f2424986450ec"}},"input_fingerprint":"128cf7cdd1263685b0a4c3f3f98d6149b2d89fd2b9b08848b1b45bbc05a5836d","assessment_fingerprint":"517b100d2e9006e313ab6d84d4f0f31593b77832f395383ba2227779470cd034","assessment_summary":{"status":"stale","file":"index/provision_link_adjudications.jsonl","total":11481,"expected":11481,"applied":0,"stale":11481,"unmatched":0,"unassessed":11481},"parent_id":"bco:6","children":[],"coverage":{"relationships":"indexed_records","recommendations":{"status":"incomplete","note":"Recommendation and study papers are not comprehensively indexed by provision."},"history":"partial"},"relationship_count":8,"relationships":[{"id":"bco:6-2--ccb_advice:inquiries/ga40_2012__c